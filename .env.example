# Clé API OpenAI côté serveur uniquement. L'abonnement ChatGPT ne paie pas l'API.
# Créer une clé sur https://platform.openai.com/api-keys et définir un budget projet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Données publiques Binance : aucune clé Binance nécessaire.
BINANCE_BASE_URL=https://data-api.binance.vision

# Accès local par défaut. Ne pas exposer le port sur Internet.
HOST=127.0.0.1
PORT=8000
DATA_DIR=data

# Requis si HOST n'est pas une adresse de bouclage : au moins 16 caractères.
# Utiliser aussi HTTPS sur un VPS.
DASHBOARD_PASSWORD=
